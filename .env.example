# Copy to .env and fill in. Pick one provider.
LLM_PROVIDER=openrouter            # openrouter | gemini

# OpenRouter (https://openrouter.ai/keys). Any model with structured-output support works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional
# EXTRACT_VERSION=v2     # extraction pipeline (v1 baseline, v2 improved)
# GEMINI_RPM=4           # free-tier Gemini keys: space calls out (about 5/min allowed)
# OPENROUTER_REASONING=  # low | medium | high; empty = model default
# OPENROUTER_PROVIDERS=Parasail,DeepInfra        # hosts to try first (others are still a fallback)
# OPENROUTER_IGNORE_PROVIDERS=Baidu,StreamLake   # hosts that returned corrupted or runaway output
# OPENROUTER_MAX_TOKENS=64000                     # per call, reasoning included
# WORKER_THREADS=3
# JOB_MAX_ATTEMPTS=4
# JOB_LEASE_S=120
# DATA_DIR=./data
